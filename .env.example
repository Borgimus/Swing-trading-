# Safe placeholders only. The Alpaca trading endpoint is intentionally not configurable.
DATABASE_URL=
RAW_IMPORT_ROOT=/var/lib/tc2000-alpaca-swing/imports
STRATEGY_CONFIG_PATH=/etc/tc2000-alpaca-swing/strategy-v1.yaml
LOG_LEVEL=INFO

# Phase 1 does not connect to Alpaca. These names are reserved for a later
# reviewed paper-only integration and must remain unset during Phase 1.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
